# Use a Neon PostgreSQL connection URL. Keep production secrets in your host's secret manager.
DATABASE_URL=postgresql+psycopg://<NEON_USER>:<NEON_PASSWORD>@<NEON_HOST>/<NEON_DATABASE>?sslmode=require
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
JWT_SECRET_KEY=<GENERATE_A_LONG_RANDOM_SECRET>
JWT_ACCESS_TOKEN_MINUTES=30
APP_ENV=development

EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=NoteNest <onboarding@resend.dev>

# Explicitly choose local only for development. Production must use google_drive.
STORAGE_BACKEND=local
UPLOAD_DIRECTORY=../storage/uploads
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

MALWARE_SCANNING_ENABLED=false
MALWARE_SCANNING_REQUIRED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
