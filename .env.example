# ==========================================
# NOTENEST - ENVIRONMENT CONFIGURATION
# ==========================================

# Database - Neon PostgreSQL
DATABASE_URL=postgresql+psycopg://<USERNAME>:<PASSWORD>@<NEON_HOST>/<DATABASE>?sslmode=require

# Frontend
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Authentication
JWT_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
JWT_ACCESS_TOKEN_MINUTES=30

# Application
APP_ENV=development

# ==========================================
# EMAIL CONFIGURATION
# ==========================================

EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=NoteNest <onboarding@resend.dev>

# ==========================================
# GOOGLE DRIVE STORAGE
# ==========================================

GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# ==========================================
# FILE UPLOAD CONFIGURATION
# ==========================================

STORAGE_BACKEND=local
UPLOAD_DIRECTORY=../storage/uploads

# ==========================================
# CLAMAV MALWARE SCANNING
# ==========================================

MALWARE_SCANNING_ENABLED=true
MALWARE_SCANNING_REQUIRED=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310